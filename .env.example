# Porta da API
PORT=3000

# String de conexão do MongoDB. Se deixar em branco/omitir, o backend sobe
# um MongoDB efêmero em memória automaticamente (só pra dev local — dados
# não persistem entre reinícios). Em produção, apontar pro MongoDB Atlas.
MONGODB_URI=

# Origem do frontend liberada no CORS (em dev, o Angular roda em 4200)
FRONTEND_ORIGIN=http://localhost:4200

# Autenticação de usuário único (sem cadastro — só essas credenciais logam)
ADMIN_EMAIL=voce@example.com
# Gerar com: node -e "console.log(require('bcryptjs').hashSync('sua-senha', 10))"
ADMIN_PASSWORD_HASH=
JWT_SECRET=troque-por-um-segredo-aleatorio-longo
